ax4.set_title('(D) 1 Peak Removed (Linear X, Log Y)')
ax4.set_xlabel('Frequency (Hz)')
ax4.set_yscale('log')
ax4.grid(True, alpha=0.2, ls=':')
ax4.legend(loc='upper right', frameon=True)


