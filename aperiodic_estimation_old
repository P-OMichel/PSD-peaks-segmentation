import numpy as np
import matplotlib.pyplot as plt
from fooof import FOOOF

# =====================================================================
# 1. SIGNAL GENERATION FUNCTIONS
# =====================================================================
def lorentzian(f, center, height, width):
    """Generates a Lorentzian peak profile."""
    return height * (width**2) / ((f - center)**2 + width**2)

def generate_psd(freqs, offset, exponent, peaks=None):
    """
    Generates a PSD consisting of a power-law (aperiodic) component
    plus optional Lorentzian peaks (periodic component).
    """
    aperiodic = 10**offset / (freqs ** exponent)

    periodic = np.zeros_like(freqs)
    if peaks is not None:
        for center, height, width in peaks:
            periodic += lorentzian(freqs, center, height, width)

    return aperiodic + periodic, aperiodic

# =====================================================================
# 2. SIMULATION SETUP & FOOOF FITTING
# =====================================================================
freqs = np.linspace(1.0, 40.0, 400)

true_offset = 0.5
true_exponent = 4.0  # Power law decay exponent

# Peak definitions
peak_params_1 = [(2.0, 10, 1.0), (12.0, 3, 2.0)] # Both peaks
peak_params_2 = [(2.0, 10, 1.0)]                  # 12 Hz peak removed

psd_with_peaks, _ = generate_psd(freqs, true_offset, true_exponent, peaks=peak_params_1)
psd_partial_peaks, _ = generate_psd(freqs, true_offset, true_exponent, peaks=peak_params_2)

# Common FOOOF settings
peak_width_limits = [0.5, 8.0]
max_n_peaks = 4
min_peak_height = 0.1

# --- FIT 1: FIXED APERIODIC MODE (NO KNEE) ---
fm_peaks_fixed = FOOOF(aperiodic_mode='fixed', peak_width_limits=peak_width_limits, max_n_peaks=max_n_peaks, min_peak_height=min_peak_height, verbose=False)
fm_partial_fixed = FOOOF(aperiodic_mode='fixed', peak_width_limits=peak_width_limits, max_n_peaks=max_n_peaks, min_peak_height=min_peak_height, verbose=False)

fm_peaks_fixed.fit(freqs, psd_with_peaks, freq_range=[freqs[0], freqs[-1]])
fm_partial_fixed.fit(freqs, psd_partial_peaks, freq_range=[freqs[0], freqs[-1]])

exp_1_fixed = fm_peaks_fixed.get_params('aperiodic')[-1]
exp_2_fixed = fm_partial_fixed.get_params('aperiodic')[-1]

# --- FIT 2: KNEE APERIODIC MODE ---
fm_peaks_knee = FOOOF(aperiodic_mode='knee', peak_width_limits=peak_width_limits, max_n_peaks=max_n_peaks, min_peak_height=min_peak_height, verbose=False)
fm_partial_knee = FOOOF(aperiodic_mode='knee', peak_width_limits=peak_width_limits, max_n_peaks=max_n_peaks, min_peak_height=min_peak_height, verbose=False)

fm_peaks_knee.fit(freqs, psd_with_peaks, freq_range=[freqs[0], freqs[-1]])
fm_partial_knee.fit(freqs, psd_partial_peaks, freq_range=[freqs[0], freqs[-1]])

exp_1_knee = fm_peaks_knee.get_params('aperiodic')[-1]
exp_2_knee = fm_partial_knee.get_params('aperiodic')[-1]


# =====================================================================
# 3. FIGURE STYLING & GENERATION
# =====================================================================
plt.rcParams.update({
    'font.size': 6.5,
    'axes.labelsize': 7.5,
    'axes.titlesize': 8.0,
    'xtick.labelsize': 6.5,
    'ytick.labelsize': 6.5,
    'legend.fontsize': 5.5,
    'figure.dpi': 300
})

def add_peak_shading(ax, peaks):
    for center, height, width in peaks:
        ax.axvspan(center - width, center + width, color='orange', alpha=0.18, lw=0, label='_nolegend_')

# ---------------------------------------------------------------------
# FIGURE 1: Fixed Aperiodic Mode (No Knee) - Smaller Figure Size
# ---------------------------------------------------------------------
fig1, axes1 = plt.subplots(2, 2, figsize=(5.5, 4.0), constrained_layout=True)
fig1.suptitle("FOOOF Aperiodic Fit: Fixed Mode (No Knee)", fontsize=9, fontweight='bold')

# (A) Both Bumps (Log-Log)
ax1 = axes1[0, 0]
add_peak_shading(ax1, peak_params_1)
ax1.plot(freqs, psd_with_peaks, color='black', lw=1.2, label='Full PSD')
ax1.plot(freqs, 10**fm_peaks_fixed.fooofed_spectrum_, color='crimson', lw=1.0, ls='--', label='Fit')
ax1.plot(freqs, fm_peaks_fixed.get_model(component='aperiodic', space='linear'), color='dodgerblue', lw=1.0, ls=':', label=f'Aper. (Exp: {exp_1_fixed:.2f})')
ax1.set_title('(A) Both Bumps (Log-Log)')
ax1.set_ylabel('PSD')
ax1.set_yscale('log')
ax1.set_xscale('log')
ax1.grid(True, alpha=0.2, ls=':')
ax1.legend(loc='upper right', frameon=True)

# (B) 12 Hz Peak Removed (Log-Log)
